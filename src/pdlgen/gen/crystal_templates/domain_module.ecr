<%# domain_module.ecr - Template for generating a Crystal domain module with commands %>
<%- # Variables: d (Pdl::Domain), domains (Array(Pdl::Domain)), base_pkg (String), referenced_domains (Array(String)) -%>
require "../cdp"
require "json"
require "time"

<%- referenced_domains.each do |ref_domain| -%>
<%- next if ref_domain == d.domain.downcase -%>
require "../<%= ref_domain %>/<%= ref_domain %>"
<%- end -%>

<%- if !d.types.empty? -%>
require "./types"
<%- end -%>
<%- if !d.events.empty? -%>
require "./events"
<%- end -%>

<%- description_lines = d.description.split('\n') -%>
<%- description_lines.each do |line| -%>
# <%= line.strip %>
<%- end -%>
<%- if d.deprecated? -%>
@[Deprecated("This domain is deprecated")]
<%- end -%>
<%- if d.experimental? -%>
@[Experimental]
<%- end -%>
module <%= base_pkg %>::<%= d.domain.camelcase %>
  <%- # Generate Result structs first (so they're defined before commands that reference them) -%>
  <%- if !d.commands.empty? -%>
    <%- d.commands.each do |command| -%>
      <%- next if command.deprecated? && !command.always_emit? -%>
      <%- next if command.returns.empty? -%>
      <%- if command.deprecated? -%>
  @[Deprecated]
      <%- end -%>
      <%- if command.experimental? -%>
  @[Experimental]
      <%- end -%>
  struct <%= command_returns_type(command) %>
    include JSON::Serializable
    <%- command.returns.each do |return_param| -%>
      <%- next if return_param.deprecated? && !return_param.always_emit? -%>
      <%- type_str = crystal_type(return_param, d, domains) -%>
    @[JSON::Field(emit_null: false)]
    <%- if bool_type?(type_str) -%>
    property? <%= return_param.name.underscore %> : <%= type_str %><%= "?" if return_param.optional? %>
    <%- else -%>
    property <%= return_param.name.underscore %> : <%= type_str %><%= "?" if return_param.optional? %>
    <%- end -%>
    <%- end -%>

    def initialize(<%= command.returns.compact_map { |return_param| next if return_param.deprecated? && !return_param.always_emit?; opt = return_param.optional?; "@#{return_param.name.underscore} : #{crystal_type(return_param, d, domains)}#{"?" if opt} = #{opt ? "nil" : crystal_default(return_param, d, domains)}" }.join(", ") %>)
    end
  end

    <%- end -%>
  <%- end -%>

  <%- if !d.commands.empty? -%>
  # Commands
    <%- d.commands.each do |cmd| -%>
      <%- next if cmd.deprecated? && !cmd.always_emit? -%>
      <%- if cmd.deprecated? -%>
  @[Deprecated]
      <%- end -%>
      <%- if cmd.experimental? -%>
  @[Experimental]
      <%- end -%>
  struct <%= command_type(cmd) %>
    include JSON::Serializable
    include <%= base_pkg %>::Request
    <%- cmd.parameters.each do |param| -%>
      <%- next if param.deprecated? && !param.always_emit? -%>
      <%- next if param.name.empty? -%>
      <%- type_str = crystal_type(param, d, domains) -%>
    @[JSON::Field(emit_null: false)]
    <%- if bool_type?(type_str) -%>
    property? <%= param.name.underscore %> : <%= type_str %><%= "?" if param.optional? %>
    <%- else -%>
    property <%= param.name.underscore %> : <%= type_str %><%= "?" if param.optional? %>
    <%- end -%>
    <%- end -%>

    def initialize(<%= cmd.parameters.compact_map { |param| next if param.deprecated? && !param.always_emit?; next if param.name.empty?; opt = param.optional?; "@#{param.name.underscore} : #{crystal_type(param, d, domains)}#{"?" if opt}#{" = nil" if opt}" }.join(", ") %>)
    end

    # ProtoReq returns the protocol method name.
    def proto_req : String
      "<%= d.domain %>.<%= cmd.name %>"
    end

    <%- if !cmd.returns.empty? -%>
    # Call sends the request and returns the result.
    def call(c : <%= base_pkg %>::Client) : <%= command_returns_type(cmd) %>
      <%= base_pkg %>.call(proto_req, self, <%= command_returns_type(cmd) %>, c)
    end
    <%- else -%>
    # Call sends the request.
    def call(c : <%= base_pkg %>::Client) : Nil
      <%= base_pkg %>.call(proto_req, self, nil, c)
    end
    <%- end -%>
  end

    <%- end -%>
  <%- end -%>
end
